# Copie para `backend/.env` e preencha. O `.env` é gitignorado.
# Para deploy no Render, veja DEPLOY.md — lá as variáveis vão no painel.

# --- Supabase (obrigatório) ---
SUPABASE_URL=https://xxxxx.supabase.co
# É a chave service_role, não a anon: o backend escreve contornando RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Pipedrive (obrigatório) ---
# A URL base é fixa no código (main.py), não é configurável aqui.
PIPEDRIVE_API_TOKEN=xxxxx

# --- Google Drive (obrigatório para sincronizar transcrição) ---
# Aceita três formatos: caminho de arquivo, o JSON colado inteiro, ou Base64.
# Local costuma ser o caminho; no Render, cole o JSON.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# --- Autenticação (obrigatório) ---
JWT_SECRET=troque-isto-por-um-segredo-de-32-caracteres-ou-mais
JWT_EXPIRATION_HOURS=24

# --- Assistente (opcional) ---
# Cascata: Gemini primeiro, NVIDIA como fallback. Sem elas, só o assistente
# para de responder; o resto do sistema segue funcionando.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=

# --- CORS (opcional em desenvolvimento) ---
# Domínios do frontend, separados por vírgula. Vazio = aceita qualquer origem,
# com aviso no startup. Em produção, preencha.
CORS_ORIGINS=
